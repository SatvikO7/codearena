<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.codearena</groupId>
    <artifactId>codearena-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>codearena-executor</artifactId>
  <name>CodeArena Executor</name>
  <description>Execution service: the only component that holds Docker control, exposing a narrow run-this-program API</description>

  <!--
    The dependency list is short on purpose, and every absence is deliberate.

    This is the one process in the system that can create containers, so its attack
    surface is kept to the smallest thing that can serve the contract in
    com.codearena.shared.execution.ExecutionApi. It has:

      * no database driver   - nothing here reads or writes submissions
      * no Redis client      - it never touches the queue
      * no security starter  - authentication is one shared-secret header checked by a
                               filter, which is the entire authorisation model it needs

    Adding any of those would give a process with Docker control a reason to parse
    something more interesting than a typed request from one caller on a private network.
  -->
  <dependencies>
    <dependency>
      <groupId>com.codearena</groupId>
      <artifactId>codearena-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!--
            Give the executable fat jar a classifier so the PLAIN jar stays the main
            artifact. Without this, repackaging replaces it and the classes end up under
            BOOT-INF/classes, where another module cannot link against them.

            The worker's JudgeVerdictIT needs to do exactly that: it drives a real sandbox
            to check that real timeouts and real OOM kills map to the right verdicts. That
            dependency is test-scoped and never ships in the worker image.
          -->
          <classifier>boot</classifier>
        </configuration>
      </plugin>
      <!-- Runs the *IT sandbox tests, which need a live Docker daemon. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
