# Normalise to LF in the repository. Without this, files checked out on Windows
# get CRLF, and a CRLF `mvnw` or shell script fails inside a Linux container with
# an opaque "bad interpreter" error.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run under cmd.exe.
*.cmd text eol=crlf
*.bat text eol=crlf

# Executable shell scripts.
mvnw text eol=lf
*.sh text eol=lf

# Binary: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.zip binary
