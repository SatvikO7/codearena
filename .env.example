# =============================================================================
# CodeArena - environment configuration template
# Copy to `.env` and adjust. NEVER commit the real `.env`.
#   cp .env.example .env
# =============================================================================

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=codearena
POSTGRES_USER=codearena
POSTGRES_PASSWORD=change-me-in-local-env

# JDBC URL used by the backend and the worker.
# Inside docker compose the host is the service name `postgres`. PostgreSQL and
# Redis are not published to the host - they sit on an internal-only network - so
# inspect them with `docker compose exec postgres psql -U codearena -d codearena`.
DATABASE_URL=jdbc:postgresql://postgres:5432/codearena
DATABASE_USERNAME=codearena
DATABASE_PASSWORD=change-me-in-local-env

# ---- Redis ------------------------------------------------------------------
# Under docker compose the services reach Redis at redis:6379 on the internal
# network; these values matter when running the backend or worker outside Docker.
REDIS_HOST=redis
REDIS_PORT=6379
# Leave empty for local development (no auth on the compose network).
REDIS_PASSWORD=

# ---- Sessions ---------------------------------------------------------------
# Authentication uses server-side sessions stored in Redis, delivered to the browser
# in an HttpOnly cookie. There is no token signing key to manage and nothing
# security-sensitive here: destroying a session in Redis revokes access immediately.
#
# How long a session survives without activity (ISO-8601 duration).
SESSION_TIMEOUT=PT2H
# Marks the session and CSRF cookies Secure. MUST be true in any environment served
# over HTTPS. Left false for local compose, which is plain HTTP - a Secure cookie
# would never be sent and nobody could sign in.
SESSION_COOKIE_SECURE=false
# BCrypt cost factor. Higher is stronger and slower; 12 is about 0.25s per login.
BCRYPT_STRENGTH=12

# ---- Backend ----------------------------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# ---- Worker -----------------------------------------------------------------
WORKER_PORT=8081
# Number of submissions a single worker process judges concurrently. Each one holds a
# sandbox container, so this bounds the containers a worker contributes to the host.
WORKER_CONCURRENCY=2

# The worker talks to the Docker daemon through a mounted socket in order to create the
# sandbox containers that run untrusted code. It runs as an unprivileged user, so it needs
# the group that owns that socket:
#   Docker Desktop (macOS/Windows) : 0
#   Linux host                     : the `docker` group, from `stat -c %g /var/run/docker.sock`
# A wrong value shows up as "permission denied while trying to connect to the docker API".
DOCKER_SOCKET_GID=0

# ---- Frontend ---------------------------------------------------------------
FRONTEND_PORT=5173
# Base URL the browser uses to reach the API.
VITE_API_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Execution service
# -----------------------------------------------------------------------------
# Shared secret between the judge worker and the execution service. The execution
# service is the only component that can create containers, so this is the credential
# that authorises "run a program in a sandbox" -- treat it like any other secret.
#
# Both services refuse to start without it, and it must be at least 32 characters.
# Generate one with:   openssl rand -hex 32
EXECUTOR_TOKEN=

# How many sandbox workspaces the execution service will hold open at once. This is a
# ceiling on concurrent sandboxes for the whole machine, not a per-user quota -- per-user
# submission limits are separate, and are configured below.
SANDBOX_MAX_OPEN_WORKSPACES=16

# -----------------------------------------------------------------------------
# Resource ceilings
# -----------------------------------------------------------------------------
# Each service has a memory and CPU limit in docker-compose.yml. They matter more
# than they look: every JVM runs with -XX:MaxRAMPercentage=75, which is a percentage
# of the CONTAINER's limit -- with no limit set, the JVM reads the host's memory and
# sizes its heap at 75% of the whole machine, three times over.
#
# Ceilings, not reservations. Raise them here rather than by editing compose.
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPUS=2
REDIS_MEM_LIMIT=512m
REDIS_CPUS=1
BACKEND_MEM_LIMIT=1g
BACKEND_CPUS=2
WORKER_MEM_LIMIT=1g
WORKER_CPUS=2
EXECUTOR_MEM_LIMIT=512m
EXECUTOR_CPUS=1
FRONTEND_MEM_LIMIT=128m
FRONTEND_CPUS=0.5

# Sandbox containers are NOT charged to the executor's limit -- they are siblings on
# the host. Their total is bounded by arithmetic instead:
#
#   worker replicas x WORKER_CONCURRENCY x per-execution memory
#
# With the defaults that is 1 x 2 x 256 MB. The per-execution ceiling is
# SANDBOX_MAX_MEMORY_MB, so the worst case a problem author can reach is
# 1 x 2 x 1024 MB. See docs/operations.md.

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# Log verbosity. DEBUG is for development only and must never be set in a deployment:
# Spring at DEBUG prints request bodies, and this application's request bodies contain
# passwords and submitted source code.
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# Empty for human-readable console logs. Set to `ecs`, `logstash` or `gelf` in a
# deployment that ships logs somewhere, and every line becomes JSON with the
# correlation fields (request id, submission id) as first-class keys.
LOG_STRUCTURED_FORMAT=

# -----------------------------------------------------------------------------
# Abuse controls
# -----------------------------------------------------------------------------
# Every value below has a working default in the image; these exist so a deployment
# can be tuned without rebuilding. `BURST` is how many requests are available at once
# and `INTERVAL` is how long one takes to come back, so the sustained rate is one
# request per interval. What each limit protects, and why it is set where it is, is in
# docs/rate-limiting.md.
#
# There are no secrets here and nothing sensitive; these are policy numbers.
RATE_LIMIT_ENABLED=true

# Whether X-Forwarded-For may be believed when identifying an anonymous caller.
# Turn this on ONLY where a reverse proxy in front of the API overwrites the header.
# Any client can send it, so trusting it without that guarantee lets an attacker pick a
# fresh rate-limit bucket for every request. The compose stack has no such proxy -- nginx
# serves the frontend and does not proxy the API -- so it stays false.
RATE_LIMIT_TRUST_FORWARDED=false

# How long one identity's rejections collapse into a single audit event and log line.
# Bounds what a rejected caller can write into the append-only audit table.
RATE_LIMIT_AUDIT_COOLDOWN=PT10M

# Login, per calling client: a flood cap, not the anti-guessing control (see below).
RATE_LIMIT_LOGIN_ORIGIN_BURST=30
RATE_LIMIT_LOGIN_ORIGIN_INTERVAL=PT2S

# Login, per account attempted, counting only failures. This is what actually stops
# password guessing, because it holds however many sources the attempts come from. A
# correct password clears it, so it is a throttle and never a lockout.
RATE_LIMIT_LOGIN_ACCOUNT_BURST=10
RATE_LIMIT_LOGIN_ACCOUNT_INTERVAL=PT30S

# Account creation, per client.
RATE_LIMIT_REGISTRATION_BURST=10
RATE_LIMIT_REGISTRATION_INTERVAL=PT2M

# Submissions per user, shared by practice and contests -- they queue into the same
# judge. Tune this against the judging capacity actually deployed (WORKER_CONCURRENCY
# times the number of workers), not against what feels generous.
RATE_LIMIT_SUBMISSION_BURST=10
RATE_LIMIT_SUBMISSION_INTERVAL=PT10S

# Contest standings: recomputed from the submission table on every request, so this is
# the most expensive read in the system. The scoreboard refreshes every 15 seconds.
RATE_LIMIT_STANDINGS_BURST=60
RATE_LIMIT_STANDINGS_INTERVAL=PT2S

# Catalogue search. Applies only when a search term is present; plain listing is not
# limited, because it is an ordinary indexed read.
RATE_LIMIT_PROBLEM_SEARCH_BURST=60
RATE_LIMIT_PROBLEM_SEARCH_INTERVAL=PT2S

# Administrative reads. Administrators are limited too -- generously, so that paging and
# refreshing a dashboard cannot reach it, but not exempted.
RATE_LIMIT_ADMIN_READ_BURST=120
RATE_LIMIT_ADMIN_READ_INTERVAL=PT1S
