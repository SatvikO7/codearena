<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.codearena</groupId>
    <artifactId>codearena-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>codearena-worker</artifactId>
  <name>CodeArena Worker</name>
  <description>Judge worker: consumes submission jobs and runs them in isolated Docker containers</description>

  <dependencies>
    <dependency>
      <groupId>com.codearena</groupId>
      <artifactId>codearena-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      The worker is deliberately NOT a web application.  It exposes an actuator
      endpoint over HTTP for health checks, but it serves no public API and is
      never reachable from the internet.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!--
      Prometheus exposition for the metrics Micrometer already collects.

      The registry is the only addition: Spring Boot's actuator brings Micrometer's core,
      and the application code talks to MeterRegistry rather than to anything
      Prometheus-shaped, so the exposition format is a deployment choice rather than a
      dependency of the code. See ADR-040.
    -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!--
      Plain JDBC, not JPA. The worker issues four statements, one of which is an atomic
      claim that has to be hand-written SQL anyway. Hibernate would add a mapping layer,
      a second-level of caching semantics and lazy-loading hazards to a process that runs
      outside any request scope, in exchange for nothing it needs.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!--
      TEST SCOPE ONLY, and the scope is the point.

      JudgeVerdictIT asserts that a real timeout, a real OOM kill and a real compiler
      failure map to the right verdicts, which needs a real sandbox to produce them.
      Stubbing the execution service would leave the mapping tested against outcomes a
      stub was told to return, which is exactly the set the code already believes in.

      At runtime the worker has no Docker code and no Docker client: it reaches the
      execution service over HTTP through RemoteExecutionService. This dependency does
      not ship in the worker image.
    -->
    <dependency>
      <groupId>com.codearena</groupId>
      <artifactId>codearena-executor</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Runs the *IT execution tests, which need a live Docker daemon. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
