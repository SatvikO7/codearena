<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.codearena</groupId>
    <artifactId>codearena-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>codearena-worker</artifactId>
  <name>CodeArena Worker</name>
  <description>Judge worker: consumes submission jobs and runs them in isolated Docker containers</description>

  <dependencies>
    <dependency>
      <groupId>com.codearena</groupId>
      <artifactId>codearena-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      The worker is deliberately NOT a web application.  It exposes an actuator
      endpoint over HTTP for health checks, but it serves no public API and is
      never reachable from the internet.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!--
      Plain JDBC, not JPA. The worker issues four statements, one of which is an atomic
      claim that has to be hand-written SQL anyway. Hibernate would add a mapping layer,
      a second-level of caching semantics and lazy-loading hazards to a process that runs
      outside any request scope, in exchange for nothing it needs.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Runs the *IT execution tests, which need a live Docker daemon. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
